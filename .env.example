# ─────────────────────────────────────────────────────────────────────────────
#  PORTFOLIO SERVER — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=production        # development | production

# ── Security ─────────────────────────────────────────────────────────────────
# Token to access the /api/visitors analytics endpoint.
# Generate a strong one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=CHANGE_THIS_TO_A_STRONG_RANDOM_TOKEN

# Comma-separated list of allowed origins for CORS.
# In development (NODE_ENV=development), it allows all origins if empty.
# In production, you MUST specify your domains.
# Example: https://arthu0x.com,https://www.arthu0x.com
ALLOWED_ORIGINS=https://yourdomain.com

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | info | http | debug  (default: info in prod, debug in dev)
LOG_LEVEL=debug

# ── RapidAPI (Cyber Tools) ────────────────────────────────────────────────────
# Get yours at https://rapidapi.com/
# If not set, the server runs in MOCK mode automatically.
RAPIDAPI_KEY=YOUR_KEY_HERE
