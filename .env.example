# ─────────────────────────────────────────────────────────────────────────────
#  PORTFOLIO SERVER — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development        # development | production

# ── Security ─────────────────────────────────────────────────────────────────
# Token to access the /api/visitors analytics endpoint.
# Generate a strong one: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
ADMIN_TOKEN=CHANGE_THIS_TO_A_STRONG_RANDOM_TOKEN

# Comma-separated list of allowed origins for CORS.
# Leave blank in development (allows all origins).
# Example for production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | info | http | debug  (default: info in prod, debug in dev)
LOG_LEVEL=debug

# ── RapidAPI (Cyber Tools) ────────────────────────────────────────────────────
# Get yours at https://rapidapi.com/
# If not set, the server runs in MOCK mode automatically.
RAPIDAPI_KEY=YOUR_KEY_HERE
